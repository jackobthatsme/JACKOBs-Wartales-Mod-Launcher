<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JACKOBsWartalesModLauncher</AssemblyName>
    <RootNamespace>JACKOBsWartalesModLauncher</RootNamespace>
    <Version>0.3.0</Version>
    <Authors>JACKOBTHATSME</Authors>
    <Description>Offline universal Wartales mod manager with transactional PAK and external-file patching.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LauncherCore.cs" />
    <Compile Remove="LauncherCore.V030.cs" />
  </ItemGroup>
</Project>
